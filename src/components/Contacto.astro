<section id="contacto">
        <h3 class="titulo">Contacto</h3>
        <div class="contenedor-form">
            <form id="formulario" onsubmit="sendEmail(event)">
                <div class="fila nombre-email">
                    <input type="text" name="user_name" placeholder="Nombre" class="input-mitad">
                    <input type="email" name="user_email" placeholder="Dirección de Email" class="input-mitad">
                </div>
                <div class="fila">
                    <input type="text" name="subject" placeholder="Asunto" class="input-full">
                </div>
                <div class="fila">
                    <textarea name="message" id="" cols="30" rows="10" placeholder="Tu Mensaje..."
                        class="input-full"></textarea>
                </div>

                <button type="submit" class="btn-enviar">Enviar Mensaje</button>
            </form>
        </div>
    </section>
